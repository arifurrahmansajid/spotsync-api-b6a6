# SpotSync Environment Configuration
# Copy this file to .env and fill in your values

# PostgreSQL Connection (use either DATABASE_URL or individual fields)
# Option A: Full DSN (e.g., NeonDB / Supabase connection string)
DATABASE_URL=postgres://username:password@host/dbname?sslmode=require

# Option B: Individual fields (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=spotsync
DB_PORT=5432
DB_SSLMODE=disable

# JWT Secret Key (change this to a strong, random value in production)
JWT_SECRET=spotsync-super-secret-jwt-key-change-me

# Server Port
PORT=8080
